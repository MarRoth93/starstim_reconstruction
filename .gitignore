# data are linked in per machine (scripts/link_data.py); never commit them
data/*
!data/README.md
configs/paths.local.yaml

# regenerable intermediate files stay on each machine
cache/
# results/ is in git, so the results can be read without rerunning anything. Not the per-recording example figures:
# they repeat THINGS photos, which we may not redistribute (results/sheets/ shows every reconstruction without photos)
results/*_examples.png

__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
